  "rules": [
    {
      "field": "COVERAGE_PROVIDER",
      "required_if": {
        "field": "COVERAGE_FLG",
        "equals": "YES"
      }
    },
    {
      "field": "COVERAGE_RATE_BPS",
      "auto": {
        "kind": "zero_if",
        "field": "COVERAGE_FLG",
        "equals": "NO"
      }
    },
    {
      "field": "FIXED_RATE_BPS",
      "required_if": {
        "field": "RATE_TYPE",
        "equals": "FIXED"
      }
    },
    {
      "field": "FLOAT_BASE_RATE",
      "required_if": {
        "field": "RATE_TYPE",
        "equals": "FLOATING"
      }
    },
    {
      "field": "FIXING_DT",
      "required_if": {
        "field": "RATE_TYPE",
        "equals": "FLOATING"
      }
    },
    {
      "field": "FIXING_DT",
      "auto": {
        "kind": "date_offset",
        "source_field": "VALUE_DT",
        "days": -2,
        "note": "varsayılan value date - 2 takvim günü; elle değiştirilebilir"
      }
    },
    {
      "field": "FLOAT_SPREAD_BPS",
      "required_if": {
        "field": "RATE_TYPE",
        "equals": "FLOATING"
      }
    },
    {
      "field": "PAYMENT_PLAN",
      "required_if": {
        "field": "REPAYMENT_SCHEDULE",
        "equals": "AMORTIZED"
      }
    },
    {
      "field": "ESG_TYPE",
      "required_if": {
        "field": "SUSTAINABILITY_FLG",
        "equals": "YES"
      }
    },
    {
      "field": "ESG_ELIGIBILITY",
      "required_if": {
        "field": "SUSTAINABILITY_FLG",
        "equals": "YES"
      }
    },
    {
      "field": "LENDER_REGION",
      "auto": {
        "kind": "list_attr",
        "list": "COUNTRY",
        "source_field": "LENDER_COUNTRY",
        "attr": "ATTR1"
      }
    },
    {
      "field": "GROUP_COMPANY",
      "auto": {
        "kind": "bank_attr",
        "source_field": "LENDER_BANK",
        "attr": "GROUP_COMPANY"
      }
    },
    {
      "field": "GROUP_COMPANY_COUNTRY",
      "auto": {
        "kind": "bank_attr",
        "source_field": "LENDER_BANK",
        "attr": "GROUP_COMPANY_COUNTRY"
      }
    },
    {
      "field": "GROUP_COMPANY_REGION",
      "auto": {
        "kind": "bank_attr",
        "source_field": "LENDER_BANK",
        "attr": "GROUP_COMPANY_REGION"
      }
    },
    {
      "field": "LENDER_COUNTRY",
      "auto": {
        "kind": "bank_attr",
        "source_field": "LENDER_BANK",
        "attr": "COUNTRY"
      }
    },
    {
      "field": "ALL_IN_RATE_BPS",
      "auto": {
        "kind": "all_in_sum",
        "note": "FIXED ise FIXED_RATE_BPS, FLOATING ise FLOAT_SPREAD_BPS + COVERAGE_RATE_BPS + additional cost toplamı; kullanıcı üzerine yazabilir"
      }
    },
    {
      "field": "ALL_IN_RATE_TXT",
      "auto": {
        "kind": "all_in_label",
        "note": "FLOATING: '{base rate etiketi} + {all-in} bps'; FIXED: '{all-in} bps (Fixed)' — sunucu otoritedir"
      }
    },
    {
      "field": "TENOR",
      "auto": {
        "kind": "date_diff",
        "from": "VALUE_DT",
        "to": "MATURITY_DT",
        "note": "Amortized'da WAL raporlama katmanında ödeme planından"
      }
    },
    {
      "field": "REPORTING_STATUS",
      "auto": {
        "kind": "derived_view",
        "note": "V_FI_OFFER_CURRENT: WON→REALIZED/PENDING (value date), LOST→UNREALIZED, BIDDING→BIDDING, statüsüz ürünler→value date'e göre REALIZED/PENDING"
      }
    }
  ]
}
